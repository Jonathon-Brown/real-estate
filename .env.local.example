# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit it.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com → API keys (used from Phase 3)
ANTHROPIC_API_KEY=

# Your credit on client-facing galleries. Leave STUDIO_NAME blank to hide the
# footer entirely; the other two are optional even when it is set.
STUDIO_NAME=
STUDIO_URL=
STUDIO_EMAIL=
